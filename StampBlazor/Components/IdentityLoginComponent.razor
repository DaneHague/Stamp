@inject IdentityAuthenticationService AuthService
@inject IJSRuntime JSRuntime

<div class="login-container">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="login-card">
            <h3>Welcome to Stamp</h3>
            <p class="text-muted">@(isRegisterMode ? "Create your account" : "Sign in to your account")</p>
            
            <EditForm Model="loginModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="loginModel.Email" placeholder="Enter your email" />
                    <ValidationMessage For="@(() => loginModel.Email)" />
                </div>
                
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" placeholder="Enter your password" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>
                
                <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @(isRegisterMode ? "Create Account" : "Sign In")
                </button>
            </EditForm>
            
            <div class="text-center">
                <button class="btn btn-link" @onclick="ToggleMode" disabled="@isLoading">
                    @(isRegisterMode ? "Already have an account? Sign in" : "Don't have an account? Register")
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @errorMessage
                </div>
            }
            
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3" role="alert">
                    @successMessage
                </div>
            }
        </div>
    }
    else
    {
        <div class="user-info">
            <div class="d-flex align-items-center">
                <div>
                    <div class="fw-bold">@AuthService.CurrentUser?.Name</div>
                    <div class="text-muted small">@AuthService.CurrentUser?.Email</div>
                </div>
                <button class="btn btn-outline-secondary ms-auto" @onclick="SignOutAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Sign Out
                </button>
            </div>
        </div>
    }
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 50vh;
    }
    
    .login-card {
        padding: 2rem;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        background-color: white;
        max-width: 400px;
        width: 100%;
    }
    
    .user-info {
        padding: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background-color: #f8f9fa;
        max-width: 400px;
        width: 100%;
    }
    
    .form-control:focus {
        border-color: #ff6b35;
        box-shadow: 0 0 0 0.2rem rgba(255, 107, 53, 0.25);
    }
    
    .btn-primary {
        background-color: #ff6b35;
        border-color: #ff6b35;
    }
    
    .btn-primary:hover {
        background-color: #e55a2b;
        border-color: #e55a2b;
    }
</style>

@code {
    private LoginModel loginModel = new();
    private bool isRegisterMode = false;
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationStateChanged += StateHasChanged;
        await AuthService.InitializeAuth();
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            IdentityAuthResult result;
            
            if (isRegisterMode)
            {
                result = await AuthService.RegisterAsync(loginModel.Email, loginModel.Password);
                if (result.Success)
                {
                    successMessage = "Account created successfully!";
                }
            }
            else
            {
                result = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
            }
            
            if (!result.Success)
            {
                errorMessage = result.ErrorMessage ?? "Authentication failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Authentication error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SignOutAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await AuthService.SignOutAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sign-out error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        loginModel = new LoginModel(); // Reset form
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= StateHasChanged;
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}