{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "_comment": "BASE CONFIGURATION - Local development settings. For production, create appsettings.local.json or use User Secrets.",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=stamp.db"
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Jwt": {
      "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong",
      "Issuer": "StampApi",
      "Audience": "StampBlazor",
      "ExpireHours": 24
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
